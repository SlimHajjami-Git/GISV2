# Build stage
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps
COPY . .
# BASE_HREF: set to /mobile/ for K8s (path-based routing), / for Docker Compose
ARG BASE_HREF=/
RUN npm run build -- --configuration=production --base-href=${BASE_HREF}

# Runtime stage
FROM nginx:alpine
ARG BASE_HREF=/
COPY --from=builder /app/www /usr/share/nginx/html
# If BASE_HREF is a subpath (e.g. /mobile/), move files into that subdirectory
# so nginx root + try_files works correctly (alias + try_files is broken in nginx)
RUN set -e; \
    if [ "$BASE_HREF" != "/" ]; then \
      subdir=$(echo "$BASE_HREF" | sed 's|^/||;s|/$||'); \
      mkdir -p /tmp/_mobile_build; \
      mv /usr/share/nginx/html/* /tmp/_mobile_build/; \
      mkdir -p "/usr/share/nginx/html/${subdir}"; \
      mv /tmp/_mobile_build/* "/usr/share/nginx/html/${subdir}/"; \
      rm -rf /tmp/_mobile_build; \
    fi
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
