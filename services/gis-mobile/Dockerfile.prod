# Build stage
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps
COPY . .
# BASE_HREF: set to /mobile/ for K8s (path-based routing), / for Docker Compose
ARG BASE_HREF=/
RUN npm run build -- --configuration=production --base-href=${BASE_HREF}

# Runtime stage
FROM nginx:alpine
# DEPLOY_SUBDIR: for K8s set to "html/mobile" so files land in /usr/share/nginx/html/mobile/
# This allows root-based try_files to work correctly (alias+try_files is broken in nginx)
ARG DEPLOY_SUBDIR=html
COPY --from=builder /app/www /usr/share/nginx/${DEPLOY_SUBDIR}
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
